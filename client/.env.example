# ==========================================
# AURASOLE FOOTWEAR - CLIENT ENVIRONMENT CONFIGURATION
# ==========================================

# Production Backend API URL (Render deployed URL)
VITE_API_URL="https://aurasole-api.onrender.com/api"

# Public Payment Gateway Client Key (Razorpay Key ID only - never place secret here)
VITE_RAZORPAY_KEY_ID="rzp_live_your_public_key_id"

# ==========================================
# FIREBASE AUTHENTICATION (Google, Facebook, Email)
# ==========================================
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="aurasole-footwear.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="aurasole-footwear"
VITE_FIREBASE_STORAGE_BUCKET="aurasole-footwear.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
