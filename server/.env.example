# ==========================================
# AURASOLE FOOTWEAR - SERVER ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port
PORT=5000
NODE_ENV=production

# Database (Neon PostgreSQL via Prisma)
# Direct connection string for migrations & pooled connection string for runtime
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret
JWT_SECRET="your_secure_random_jwt_secret_key_here"

# Frontend Allowed Origin for CORS
FRONTEND_URL="https://aurasolefootwear.com"

# Payment Gateway Credentials (Razorpay)
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# WhatsApp Business API (Optional)
WHATSAPP_API_TOKEN="your_whatsapp_business_api_token"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"

# Email Provider (Optional - SendGrid / Resend / SMTP)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="your_sendgrid_api_key"
FROM_EMAIL="orders@aurasolefootwear.com"
